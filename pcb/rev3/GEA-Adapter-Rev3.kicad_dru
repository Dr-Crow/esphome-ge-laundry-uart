(version 1)

# KiCad's HCTL-recommended land pattern places J4 contact pads 0.1847 mm
# from J4's own locating holes. Keep the board-wide hole clearance unchanged.
(rule "HCTL USB-C locating-hole clearance"
  (condition "A.memberOfFootprint('Connector_USB:USB_C_Receptacle_HCTL_HC-TYPE-C-16P-01A') || B.memberOfFootprint('Connector_USB:USB_C_Receptacle_HCTL_HC-TYPE-C-16P-01A')")
  (constraint hole_clearance (min 0.18mm)))

(rule "USB data pair skew"
  (condition "A.hasNetclass('USBData')")
  (constraint skew (max 1mm) (within_diff_pairs)))

(rule "USB data pair via limit"
  (condition "A.hasNetclass('USBData')")
  (constraint via_count (max 2)))
